# Copy to .env and fill in. .env is gitignored. Never commit real values.

# --- Database -------------------------------------------------------------
# Tiger Cloud STANDARD service (MLH gives $1,000 / 30 days, see
# docs/research/tigerdata.md). sslmode=require is mandatory.
# The password is shown ONCE, in the config file downloaded at service creation.
DATABASE_URL=postgresql://tsdbadmin:PASSWORD@HOST.tsdb.cloud.timescale.com:PORT/tsdb?sslmode=require
# Fallback only, if the cloud fails:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/reagent

# --- Models ---------------------------------------------------------------
# Create a CAPPED key: POST /api/v1/keys {"name":"eval","limit":10,"limit_reset":"daily"}
# The limit may not be editable later, so set it correctly at creation.
OPENROUTER_API_KEY=sk-or-v1-...

# --- GitHub connector (wrapper on :7102) ----------------------------------
GITHUB_BOT_TOKEN=
GITHUB_USER_TOKEN=
GITHUB_APP_ID=
GITHUB_WEBHOOK_SECRET=
GITHUB_TEST_REPO=your-org/infra
PUBLIC_WEBHOOK_URL=https://....ngrok-free.app

# --- Slack connector (wrapper on :7101) -----------------------------------
SLACK_BOT_TOKEN=
SLACK_USER_TOKEN=
SLACK_SIGNING_SECRET=

# --- Service ports (from the registry YAMLs; do not change) ---------------
MEMORY_WRAPPER_PORT=7100
SLACK_WRAPPER_PORT=7101
GITHUB_WRAPPER_PORT=7102
RUNTIME_PORT=8000
DASHBOARD_PORT=3000

NEXT_PUBLIC_API_URL=http://localhost:8000
