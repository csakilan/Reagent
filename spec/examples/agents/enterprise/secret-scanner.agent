apiVersion: reagent/v0
kind: Agent
metadata:
  name: secret-scanner
  version: 1.1.0
  level: enterprise
  access: service             # any agent may call it as a sub-agent; config hidden
  tags: [security, service]
spec:
  use_case:
    description: Scans text or a diff for credentials and reports where they are, never what they are.
    desired_outcome: No credential in a scanned diff goes unreported, and no credential value ever appears in output.
  model:
    id: gpt-mini
    params: { temperature: 0 }
  budget: { usd_per_run: 0.02, max_steps: 3, timeout_seconds: 60 }
  ownership: { owners: [grace] }
  prompt:
    task: |
      Identify anything that looks like a credential (API keys, tokens, private keys, passwords,
      connection strings). Return file, line, kind and confidence. NEVER return the value itself.
  input:
    type: object
    properties: { text: { type: string } }
    required: [text]
  output:
    type: object
    properties:
      findings:
        type: array
        items:
          type: object
          properties: { file: {type: string}, line: {type: integer}, kind: {type: string}, confidence: {type: number} }
    required: [findings]
  triggers:
    - { type: agent }
  evaluation:
    runs_per_case: 3
    thresholds: { pass_rate: 0.95 }
    cases:
      - name: finds-github-token
        input: { text: "+token = \"ghp_1234567890abcdefghijklmnopqrstuvwxyzAB\"" }
        expect:
          output_not_contains: ["ghp_1234567890"]
          judge: "Does the output report one GitHub token without revealing its value?"
