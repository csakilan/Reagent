{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "reagent/v0",
  "title": "ReAgent v0 document",
  "type": "object",
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "additionalProperties": false,
  "properties": {
    "apiVersion": {
      "const": "reagent/v0"
    },
    "kind": {
      "enum": [
        "Enterprise",
        "Team",
        "Connector",
        "Model",
        "Agent"
      ]
    },
    "metadata": {
      "$ref": "#/$defs/metadata"
    },
    "spec": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "Enterprise"
          }
        }
      },
      "then": {
        "properties": {
          "spec": {
            "$ref": "#/$defs/enterpriseSpec"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "Team"
          }
        }
      },
      "then": {
        "properties": {
          "spec": {
            "$ref": "#/$defs/teamSpec"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "Connector"
          }
        }
      },
      "then": {
        "properties": {
          "spec": {
            "$ref": "#/$defs/connectorSpec"
          },
          "metadata": {
            "required": [
              "name",
              "version"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "Model"
          }
        }
      },
      "then": {
        "properties": {
          "spec": {
            "$ref": "#/$defs/modelSpec"
          },
          "metadata": {
            "required": [
              "name",
              "version"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "Agent"
          }
        }
      },
      "then": {
        "properties": {
          "spec": {
            "$ref": "#/$defs/agentSpec"
          },
          "metadata": {
            "required": [
              "name",
              "version",
              "level"
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "metadata": {
                  "properties": {
                    "level": {
                      "const": "team"
                    }
                  }
                }
              }
            },
            "then": {
              "properties": {
                "metadata": {
                  "required": [
                    "team"
                  ],
                  "properties": {
                    "access": {
                      "const": "team"
                    }
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "metadata": {
                  "properties": {
                    "level": {
                      "const": "enterprise"
                    }
                  }
                }
              }
            },
            "then": {
              "properties": {
                "metadata": {
                  "required": [
                    "access"
                  ],
                  "not": {
                    "required": [
                      "team"
                    ]
                  },
                  "properties": {
                    "access": {
                      "enum": [
                        "private",
                        "run_only",
                        "service"
                      ]
                    }
                  }
                }
              }
            }
          }
        ]
      }
    }
  ],
  "$defs": {
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "semver": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z.-]+)?$"
    },
    "agentRef": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*(@[~^]?\\d+(\\.\\d+){0,2})?$"
    },
    "risk": {
      "enum": [
        "read",
        "write",
        "destructive"
      ]
    },
    "pattern": {
      "type": "string",
      "description": "action name or glob, e.g. messages.* or *"
    },
    "qualifiedAction": {
      "type": "string",
      "pattern": "^[a-z0-9-]+:[A-Za-z0-9_.*-]+$"
    },
    "notifyTarget": {
      "type": "string",
      "pattern": "^(slack:#[a-z0-9_-]+|email:.+|user:[a-z0-9-]+)$"
    },
    "principals": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "triggerType": {
      "enum": [
        "http",
        "mcp",
        "schedule",
        "github",
        "slack",
        "agent"
      ]
    },
    "metadata": {
      "type": "object",
      "required": [
        "name"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "$ref": "#/$defs/name"
        },
        "version": {
          "$ref": "#/$defs/semver"
        },
        "description": {
          "type": "string"
        },
        "level": {
          "enum": [
            "team",
            "enterprise"
          ]
        },
        "team": {
          "$ref": "#/$defs/name"
        },
        "access": {
          "enum": [
            "team",
            "private",
            "run_only",
            "service"
          ],
          "default": "team"
        },
        "forked_from": {
          "$ref": "#/$defs/agentRef"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "usd_per_month": {
          "type": "number",
          "minimum": 0
        },
        "usd_per_run": {
          "type": "number",
          "minimum": 0
        },
        "max_steps": {
          "type": "integer",
          "minimum": 1
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "max_call_depth": {
          "type": "integer",
          "minimum": 0
        },
        "max_concurrent_runs": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "require_for_risk": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/risk"
          }
        },
        "actions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/qualifiedAction"
          }
        },
        "timeout_minutes": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "redaction": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "secrets": {
          "type": "boolean"
        },
        "pii": {
          "type": "boolean"
        },
        "custom_patterns": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "layerGuardrails": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "redaction": {
          "$ref": "#/$defs/redaction"
        },
        "approval": {
          "$ref": "#/$defs/approval"
        },
        "deny": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/qualifiedAction"
          }
        },
        "audit_log": {
          "type": "boolean"
        }
      }
    },
    "grant": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allow": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/pattern"
          }
        },
        "deny": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/pattern"
          }
        },
        "resources": {
          "$ref": "#/$defs/resources"
        },
        "auth_modes": {
          "type": "array",
          "items": {
            "enum": [
              "service",
              "on_behalf_of"
            ]
          }
        }
      }
    },
    "allowList": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allow": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "bucket": {
      "type": "object",
      "required": [
        "name",
        "type"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "$ref": "#/$defs/name"
        },
        "type": {
          "enum": [
            "semantic",
            "episodic",
            "procedural"
          ]
        },
        "read": {
          "$ref": "#/$defs/principals"
        },
        "write": {
          "$ref": "#/$defs/principals"
        },
        "retention_days": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "memoryLayer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "buckets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/bucket"
          }
        }
      }
    },
    "evalCase": {
      "type": "object",
      "required": [
        "name",
        "input",
        "expect"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "input": {},
        "mocks": {
          "type": "object",
          "description": "qualified action -> canned response"
        },
        "expect": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "tool_calls": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/qualifiedAction"
              }
            },
            "no_tool_calls": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/qualifiedAction"
              }
            },
            "output_contains": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "output_not_contains": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "output_matches_schema": {
              "type": "boolean"
            },
            "judge": {
              "type": "string"
            },
            "side_effects": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "action"
                ],
                "additionalProperties": false,
                "properties": {
                  "action": {
                    "$ref": "#/$defs/qualifiedAction"
                  },
                  "args_contains": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "count": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            },
            "reference": {
              "type": "string",
              "description": "answer key the LLM judge grades against"
            }
          }
        },
        "kind": {
          "enum": [
            "positive",
            "negative",
            "safety"
          ],
          "default": "positive",
          "description": "positive: known defect to find; negative: must not false-alarm; safety: must pass 100%"
        },
        "origin": {
          "enum": [
            "author",
            "evaluator",
            "default"
          ],
          "description": "who wrote the case; review state lives in the database"
        }
      }
    },
    "connectorSpec": {
      "type": "object",
      "required": [
        "transport",
        "auth",
        "actions"
      ],
      "additionalProperties": false,
      "properties": {
        "transport": {
          "type": "object",
          "required": [
            "type"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "mcp"
            },
            "url": {
              "type": "string"
            },
            "command": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "oneOf": [
            {
              "required": [
                "url"
              ]
            },
            {
              "required": [
                "command"
              ]
            }
          ]
        },
        "auth": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "service": {
              "$ref": "#/$defs/authMode"
            },
            "on_behalf_of": {
              "$ref": "#/$defs/authMode"
            },
            "none": {
              "const": true
            }
          }
        },
        "actions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "name",
              "risk"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_.-]+$"
              },
              "description": {
                "type": "string"
              },
              "risk": {
                "$ref": "#/$defs/risk"
              },
              "resources": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "authMode": {
      "type": "object",
      "required": [
        "env"
      ],
      "additionalProperties": false,
      "properties": {
        "env": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$"
        }
      }
    },
    "modelSpec": {
      "type": "object",
      "required": [
        "provider",
        "model"
      ],
      "additionalProperties": false,
      "properties": {
        "provider": {
          "enum": [
            "openrouter",
            "openai_compatible"
          ]
        },
        "model": {
          "type": "string",
          "description": "provider model ID, e.g. anthropic/claude-sonnet-4.5"
        },
        "endpoint": {
          "type": "string"
        },
        "context_window": {
          "type": "integer",
          "minimum": 1
        },
        "supports_tools": {
          "type": "boolean"
        }
      }
    },
    "enterpriseSpec": {
      "type": "object",
      "required": [
        "models",
        "connectors"
      ],
      "additionalProperties": false,
      "properties": {
        "prompt": {
          "type": "string"
        },
        "admins": {
          "$ref": "#/$defs/principals"
        },
        "models": {
          "$ref": "#/$defs/allowList"
        },
        "connectors": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/grant"
          }
        },
        "triggers": {
          "$ref": "#/$defs/allowList"
        },
        "guardrails": {
          "$ref": "#/$defs/layerGuardrails"
        },
        "limits": {
          "$ref": "#/$defs/limits"
        },
        "evaluation": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "default_cases": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/evalCase"
              }
            },
            "judge": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "model": {
                  "$ref": "#/$defs/name"
                },
                "votes": {
                  "type": "integer",
                  "minimum": 1,
                  "default": 3
                },
                "min_agreement": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1,
                  "default": 0.85
                },
                "calibration_min_labels": {
                  "type": "integer",
                  "minimum": 1,
                  "default": 30
                }
              }
            },
            "requirements": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "min_cases": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "positive": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "negative": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "safety": {
                      "type": "integer",
                      "minimum": 0
                    }
                  }
                },
                "tool_coverage": {
                  "type": "boolean"
                },
                "require_second_reviewer": {
                  "type": "boolean",
                  "default": false
                }
              }
            }
          }
        },
        "memory": {
          "$ref": "#/$defs/memoryLayer"
        },
        "observability": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "log_retention_days": {
              "type": "integer",
              "minimum": 1
            },
            "trace_payloads": {
              "enum": [
                "redacted",
                "metadata_only"
              ]
            }
          }
        },
        "locked": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "teamSpec": {
      "type": "object",
      "required": [
        "members"
      ],
      "additionalProperties": false,
      "properties": {
        "members": {
          "$ref": "#/$defs/principals"
        },
        "approvers": {
          "$ref": "#/$defs/principals",
          "description": "members who can approve paused actions"
        },
        "prompt": {
          "type": "string"
        },
        "models": {
          "$ref": "#/$defs/allowList"
        },
        "connectors": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/grant"
          }
        },
        "triggers": {
          "$ref": "#/$defs/allowList"
        },
        "guardrails": {
          "$ref": "#/$defs/layerGuardrails"
        },
        "limits": {
          "$ref": "#/$defs/limits"
        },
        "evaluation": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "default_cases": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/evalCase"
              }
            },
            "requirements": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "min_cases": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "positive": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "negative": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "safety": {
                      "type": "integer",
                      "minimum": 0
                    }
                  }
                },
                "tool_coverage": {
                  "type": "boolean"
                },
                "require_second_reviewer": {
                  "type": "boolean",
                  "default": false
                }
              }
            }
          }
        },
        "memory": {
          "$ref": "#/$defs/memoryLayer"
        },
        "locked": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "agentSpec": {
      "type": "object",
      "required": [
        "use_case",
        "model",
        "prompt",
        "triggers",
        "ownership"
      ],
      "additionalProperties": false,
      "properties": {
        "use_case": {
          "type": "object",
          "required": [
            "description",
            "desired_outcome"
          ],
          "additionalProperties": false,
          "properties": {
            "description": {
              "type": "string",
              "minLength": 1
            },
            "when_to_use": {
              "type": "string"
            },
            "desired_outcome": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "tools": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "connector",
              "actions"
            ],
            "additionalProperties": false,
            "properties": {
              "connector": {
                "$ref": "#/$defs/name"
              },
              "actions": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "#/$defs/pattern"
                }
              },
              "resources": {
                "$ref": "#/$defs/resources"
              },
              "auth": {
                "enum": [
                  "service",
                  "on_behalf_of"
                ],
                "default": "service"
              }
            }
          }
        },
        "sub_agents": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "ref"
            ],
            "additionalProperties": false,
            "properties": {
              "ref": {
                "$ref": "#/$defs/agentRef"
              },
              "description": {
                "type": "string"
              }
            }
          }
        },
        "model": {
          "type": "object",
          "required": [
            "id"
          ],
          "additionalProperties": false,
          "properties": {
            "id": {
              "$ref": "#/$defs/name"
            },
            "fallback": {
              "$ref": "#/$defs/name"
            },
            "params": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "temperature": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 2
                },
                "max_tokens": {
                  "type": "integer",
                  "minimum": 1
                },
                "top_p": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              }
            }
          }
        },
        "budget": {
          "$ref": "#/$defs/limits"
        },
        "ownership": {
          "type": "object",
          "required": [
            "owners"
          ],
          "additionalProperties": false,
          "properties": {
            "owners": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            },
            "maintainers": {
              "$ref": "#/$defs/principals"
            }
          }
        },
        "evaluation": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "runs_per_case": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            },
            "thresholds": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "pass_rate": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "max_usd_per_run": {
                  "type": "number",
                  "minimum": 0
                },
                "max_p95_seconds": {
                  "type": "number",
                  "minimum": 0
                }
              }
            },
            "cases": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/evalCase"
              }
            },
            "production": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "sample_rate": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              }
            }
          }
        },
        "triggers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "type"
            ],
            "additionalProperties": false,
            "properties": {
              "type": {
                "$ref": "#/$defs/triggerType"
              },
              "cron": {
                "type": "string"
              },
              "events": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "repos": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "channels": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "input": {
                "description": "fixed input for scheduled runs"
              }
            }
          }
        },
        "guardrails": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "approval": {
              "$ref": "#/$defs/approval"
            },
            "deny": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/qualifiedAction"
              }
            },
            "redaction": {
              "$ref": "#/$defs/redaction"
            }
          }
        },
        "prompt": {
          "type": "object",
          "required": [
            "task"
          ],
          "additionalProperties": false,
          "properties": {
            "task": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "memory": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "bucket",
              "mode"
            ],
            "additionalProperties": false,
            "properties": {
              "bucket": {
                "$ref": "#/$defs/name"
              },
              "mode": {
                "enum": [
                  "read",
                  "write",
                  "read_write"
                ]
              }
            }
          }
        },
        "observability": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "metrics": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              }
            },
            "alerts": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "when",
                  "notify"
                ],
                "additionalProperties": false,
                "properties": {
                  "when": {
                    "type": "string"
                  },
                  "notify": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/notifyTarget"
                    }
                  }
                }
              }
            }
          }
        },
        "failure": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "retries": {
              "type": "integer",
              "minimum": 0
            },
            "retry_on": {
              "type": "array",
              "items": {
                "enum": [
                  "timeout",
                  "model_error",
                  "connector_error",
                  "validation_error"
                ]
              }
            },
            "on_failure": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "notify": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/notifyTarget"
                  }
                },
                "call_agent": {
                  "$ref": "#/$defs/agentRef"
                }
              }
            }
          }
        },
        "input": {
          "type": "object",
          "description": "JSON Schema for run input"
        },
        "output": {
          "type": "object",
          "description": "JSON Schema for run output"
        }
      }
    }
  }
}